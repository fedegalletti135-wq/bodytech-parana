---
import { siteConfig } from "../config/site";
const currentYear = new Date().getFullYear();
const whatsappUrl = `https://api.whatsapp.com/send?phone=${siteConfig.whatsappNumber}&text=${encodeURIComponent(siteConfig.whatsappMessage)}`;

const navLinks = [
  { label: "Inicio", href: "#inicio" },
  { label: "Tecnología", href: "#tecnologia" },
  { label: "Servicios", href: "#servicios" },
  { label: "Convenios", href: "#convenios" },
  { label: "Sedes", href: "#sedes" },
];
---

<footer class="bg-stone-950 text-stone-400 pt-16 pb-8 border-t border-stone-800">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-12">
      
      <div class="space-y-3">
        <h3 class="font-title text-2xl font-bold text-white flex items-center gap-2">
          <svg viewBox="2 2 14 14" fill="currentColor" class="w-5 h-5 text-[#B77D7D]">
            <path d="M6,6.2 C5,5.1 4,4.2 3.5,4 C3.8,4.5 4.5,5.5 5,6 Z" opacity="0.8" />
            <path d="M6.5,6 C5.5,4.8 4.6,3.8 4.2,3.5 C4.5,4 5.2,5 5.6,5.8 Z" opacity="0.8" />
            <path d="M6.8,6.5 C6.6,7.5 5.8,11.5 6.2,12.5 C6.6,13.2 7,13.5 7.2,12.8 C7.4,12.1 7.2,7.5 7,6.5 Z" />
            <path d="M7.1,7.2 C8.5,5.8 12.5,4.2 14,6.2 C15.5,8.2 13.5,10.2 7.4,9.5 Z" />
            <path d="M7.2,9.8 C8.8,9.5 12.8,9.8 13.2,11.2 C13.6,12.6 11,13.2 7.3,11.8 Z" />
          </svg>
          Bodytech
        </h3>
        <p class="text-xs text-stone-400 leading-relaxed">{siteConfig.tagline} · Paraná, Entre Ríos</p>
        
        {/* Redes Sociales Oficiales */}
        <div class="flex items-center gap-3 pt-2">
          {siteConfig.social.instagram && (
            <a href={siteConfig.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram Oficial Bodytech Paraná" class="w-9 h-9 rounded-full bg-stone-900 border border-stone-800 flex items-center justify-center text-stone-300 hover:text-white hover:border-[#B77D7D] transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
            </a>
          )}
          {siteConfig.social.facebook && (
            <a href={siteConfig.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook Oficial Bodytech Paraná" class="w-9 h-9 rounded-full bg-stone-900 border border-stone-800 flex items-center justify-center text-stone-300 hover:text-white hover:border-[#B77D7D] transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
          )}
        </div>
      </div>

      <div class="space-y-3">
        <h4 class="font-sub text-xs font-bold uppercase tracking-wider text-white">Navegación</h4>
        <ul class="space-y-1.5 text-xs">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-white transition-colors no-underline">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="space-y-3">
        <h4 class="font-sub text-xs font-bold uppercase tracking-wider text-white">Sedes en Paraná</h4>
        <p class="text-xs text-stone-400">
          • Sede Noreste: Soler 3026<br />
          • Sede Centro: España 257 (Pránika)
        </p>
        <div class="pt-2">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-[#25D366] text-stone-950 font-bold px-4 py-2 rounded-full text-xs no-underline hover:bg-[#20BA5C] transition-colors shadow-md"
          >
            Reservar Turno
          </a>
        </div>
      </div>

    </div>

    <div class="border-t border-stone-800/80 pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-stone-500 gap-3">
      <p>© {currentYear} {siteConfig.businessName}. Todos los derechos reservados.</p>
      <p>Paraná, Entre Ríos, Argentina.</p>
    </div>
  </div>
</footer>
