---
import { siteConfig } from "../config/site";
---

<section class="py-20 sm:py-28 bg-[#F4ECE7] border-t border-[#B77D7D]/15">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
    <h2 class="font-title text-3xl sm:text-4xl font-bold text-[#3C3535] mb-8">
      Horarios de Atención
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-md mx-auto">
      {siteConfig.schedule.map((item) => (
        <div class="bg-white border border-[#B77D7D]/15 rounded-2xl p-6 text-center shadow-xs">
          <h3 class="font-sub font-bold text-sm text-[#3C3535]">{item.days}</h3>
          <p class="text-lg font-bold mt-2 text-[#B77D7D]">
            {item.hours}
          </p>
        </div>
      ))}
    </div>

    <p class="text-[#6e6464] text-xs mt-6">
      Atendemos en Paraná con previa reserva de turno.
    </p>
  </div>
</section>
