---
import { siteConfig } from "../config/site";
const whatsappUrl = `https://api.whatsapp.com/send?phone=${siteConfig.whatsappNumber}&text=${encodeURIComponent(siteConfig.whatsappMessage)}`;
---

<section id="inicio" class="relative min-h-[80vh] flex items-center justify-center overflow-hidden pt-28 pb-16 bg-[#FCF9F6]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 relative z-10 text-center space-y-6">
    
    {/* Marca superior destacada con tipografía de logo */}
    <span class="font-title text-2xl sm:text-3xl font-bold tracking-wide text-[#B77D7D] block mb-2">
      Bodytech
    </span>

    <h1 class="font-title text-4xl sm:text-6xl lg:text-7xl font-bold tracking-tight leading-[1.1] text-[#3C3535]">
      Tu piel suave <br />
      <span class="text-[#6e6464] italic font-normal">y luminosa</span>
    </h1>

    <p class="text-sm sm:text-base md:text-lg text-[#6e6464] leading-relaxed max-w-2xl mx-auto font-normal">
      {siteConfig.description}
    </p>

    {/* CTAs de acción rápida */}
    <div class="pt-6 flex flex-wrap items-center justify-center gap-4">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-[#B77D7D] hover:bg-[#a36969] text-white font-bold text-sm px-8 py-4 rounded-full flex items-center gap-2 shadow-lg shadow-[#B77D7D]/25 hover:scale-[1.03] active:scale-[0.98] transition-all no-underline"
      >
        Quiero reservar mi turno
      </a>

      <a
        href="#tecnologia"
        class="bg-white hover:bg-[#F4ECE7] text-[#3C3535] border border-[#B77D7D]/30 font-semibold text-sm px-8 py-4 rounded-full flex items-center gap-2 transition-all no-underline hover:border-[#B77D7D] shadow-xs"
      >
        Ver Tecnología
      </a>
    </div>

    {/* Badge de Tecnología Indolora */}
    <div class="pt-8 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-[#B77D7D]/20 text-xs text-[#6e6464] shadow-xs">
      <span class="w-2 h-2 rounded-full bg-[#B77D7D]"></span>
      Tecnología Crystal 3D original · Enfriamiento Continuo
    </div>
  </div>
</section>
