---
import { siteConfig } from "../config/site";
const whatsappUrl = `https://api.whatsapp.com/send?phone=${siteConfig.whatsappNumber}&text=${encodeURIComponent(siteConfig.whatsappMessage)}`;
---

<section id="inicio" class="relative min-h-[90vh] flex items-center pt-36 pb-20 sm:pt-40 sm:pb-24 overflow-hidden bg-[#FCF9F6]">
  <div class="max-w-6xl mx-auto px-6 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-14 items-center">
      
      {/* Columna de Texto */}
      <div class="hero-content max-w-xl text-center lg:text-left mx-auto lg:mx-0">
        <span class="hero-brand-tag block font-title text-xl sm:text-2xl lg:text-3xl font-bold text-[#B77D7D] mb-2 tracking-wide text-center lg:text-left">
          Bodytech
        </span>
        
        <h1 class="font-title text-4xl sm:text-5xl lg:text-[3.8rem] font-bold leading-[1.1] text-[#3C3535] mb-6">
          Tu piel suave <br />
          y luminosa
        </h1>

        <p class="text-base sm:text-lg text-[#6e6464] leading-relaxed mb-8">
          {siteConfig.description}
        </p>

        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-4">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-[#B77D7D] hover:bg-[#a36969] text-white font-bold text-sm sm:text-base px-8 py-4 rounded-full shadow-lg shadow-[#B77D7D]/25 transition-all transform hover:scale-[1.02] active:scale-[0.98] no-underline"
          >
            Quiero reservar mi turno
          </a>

          <a
            href="#tecnologia"
            class="bg-transparent hover:bg-white text-[#3C3535] border border-[#B77D7D]/40 hover:border-[#B77D7D] font-semibold text-sm sm:text-base px-8 py-4 rounded-full transition-all no-underline shadow-xs"
          >
            Ver Tecnología
          </a>
        </div>
      </div>

      {/* Columna Visual con Imagen Asimétrica y Badge Flotante */}
      <div class="hero-visual relative hidden md:flex justify-center items-center">
        <div class="relative w-full max-w-[440px] aspect-[4/5] rounded-[120px_40px_120px_40px] overflow-hidden shadow-[0_20px_50px_rgba(197,139,139,0.18)] border-4 border-white bg-[#F4ECE7]">
          <img
            src="/hero_skincare.png"
            alt="Tratamiento de piel suave y saludable en Bodytech Paraná"
            class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
            loading="eager"
            fetchpriority="high"
          />
        </div>

        {/* Badge Flotante Crystal 3D */}
        <div class="absolute bottom-8 -left-4 sm:-left-6 bg-white/95 backdrop-blur-sm py-3.5 px-6 rounded-2xl shadow-[0_12px_35px_rgba(197,139,139,0.18)] border border-[#B77D7D]/15 flex items-center gap-3.5 animate-bounce-subtle">
          <div class="w-10 h-10 rounded-full bg-[#B77D7D]/15 text-[#B77D7D] flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3L12 3Z"/>
            </svg>
          </div>
          <div>
            <span class="font-bold text-sm text-[#3C3535] block leading-tight">Crystal 3D</span>
            <p class="text-xs text-[#6e6464] m-0">Tecnología Indolora</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  @keyframes bounceSubtle {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  .animate-bounce-subtle {
    animation: bounceSubtle 4s ease-in-out infinite;
  }
</style>
