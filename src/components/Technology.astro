---
import { siteConfig } from "../config/site";

const iconMap: Record<string, string> = {
  award: '<circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/>',
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  sparkles: '<path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3L12 3Z"/>',
};
---

<section id="tecnologia" class="py-24 sm:py-32 bg-stone-900/50 border-y border-stone-800/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-16 space-y-3">
      <h2 class="font-title text-3xl sm:text-5xl font-bold tracking-tight text-white">
        El Equipo Más Avanzado
      </h2>
      <p class="text-stone-300 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
        La marca de nuestro equipo es la más avanzada en tecnología estética a nivel global. Trabajamos con tecnología <strong>Body Health</strong> original, reconocida por su innovación y altos estándares de calidad.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {siteConfig.technology.map((item) => (
        <div class="bg-stone-950/80 hover:bg-stone-900 border border-stone-800/80 hover:border-[#B77D7D]/40 rounded-2xl p-7 transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-[#B77D7D]/15 text-[#B77D7D] flex items-center justify-center mb-5">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={iconMap[item.icon]} />
            </div>
            <h3 class="font-title text-xl font-bold text-white mb-3">
              {item.title}
            </h3>
            <p class="text-stone-400 text-sm leading-relaxed">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
