---
import { siteConfig } from "../config/site";
---

<section id="nosotros" class="py-24 sm:py-32 bg-[#FCF9F6] border-t border-[#B77D7D]/15">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center space-y-6">
    <span class="font-sub text-xs uppercase font-bold tracking-widest text-[#B77D7D]">
      Compromiso y Confianza
    </span>
    <h2 class="font-title text-3xl sm:text-5xl font-bold text-[#3C3535]">
      Servicio de Excelencia en Paraná
    </h2>
    <p class="text-[#6e6464] text-sm sm:text-base leading-relaxed max-w-3xl mx-auto">
      En <strong>Bodytech Paraná</strong> nos dedicamos a brindar un servicio estético de primer nivel. Combinamos operadoras certificadas con amplia experiencia y la tecnología más avanzada del mercado para que disfrutes de una piel suave, renovada y cuidada con absoluta seguridad.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-10 border-t border-[#B77D7D]/15">
      <div class="p-4">
        <div class="font-title text-3xl sm:text-4xl font-bold text-[#B77D7D]">Crystal 3D</div>
        <p class="text-xs text-[#6e6464] mt-1">Tecnología original Body Health</p>
      </div>
      <div class="p-4">
        <div class="font-title text-3xl sm:text-4xl font-bold text-[#B77D7D]">100%</div>
        <p class="text-xs text-[#6e6464] mt-1">Operadoras certificadas</p>
      </div>
      <div class="p-4">
        <div class="font-title text-3xl sm:text-4xl font-bold text-[#B77D7D]">2 Sedes</div>
        <p class="text-xs text-[#6e6464] mt-1">Sede Centro y Sede Noreste</p>
      </div>
    </div>
  </div>
</section>
